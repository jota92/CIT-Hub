<Page
    x:Class="CITHub.Windows.Views.TimetablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="36,28">
        <StackPanel Spacing="22" MaxWidth="1040">
            <TextBlock Text="時間割" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="TimetableStatus" Text="ポータルから取得した時間割を表示します。授業を選ぶと、メモと板書を確認できます。" TextWrapping="Wrap" Opacity="0.72" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="時間割を更新" Click="OnOpenPortal" />
                <Button Content="年間スケジュール" Click="OnOpenCalendar" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DaySelector" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>
            <ListView x:Name="ScheduleList" IsItemClickEnabled="True" ItemClick="OnCourseSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,10" ColumnDefinitions="4,12,*">
                            <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.72" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
