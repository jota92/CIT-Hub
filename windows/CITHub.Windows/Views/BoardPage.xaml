<Page
    x:Class="CITHub.Windows.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="36,28" RowDefinitions="Auto,Auto,*" RowSpacing="20">
        <TextBlock Text="板書" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="写真を追加" Click="OnAddPhoto" />
            <Button Content="保存先を開く" Click="OnOpenFolder" />
        </StackPanel>
        <GridView Grid.Row="2" x:Name="Photos" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnPhotoSelected">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="210" Height="150" Stretch="UniformToFill" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
