<Page
    x:Class="CITHub.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="36,28">
        <StackPanel Spacing="24" MaxWidth="760">
            <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Spacing="10">
                <TextBlock Text="marinアカウント" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="UserId" Header="MARINE User ID" />
                <PasswordBox x:Name="Password" Header="パスワード" />
                <Button Content="端末に保存" HorizontalAlignment="Left" Click="OnSaveCredentials" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="ポータル二要素認証" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="otpauth:// URL またはシークレットを入力します。設定はWindows資格情報マネージャーで保護します。" TextWrapping="Wrap" Opacity="0.72" />
                <PasswordBox x:Name="OtpSecret" Header="Authenticator設定" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="登録" Click="OnSaveOtp" />
                    <Button Content="現在のコードを表示" Click="OnShowCode" />
                </StackPanel>
                <TextBlock x:Name="OtpCode" FontFamily="Consolas" FontSize="28" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="表示" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="DarkMode" Header="ダークモード" Toggled="OnThemeChanged" />
                <TextBlock Text="テーマカラーはWindowsのアクセントカラーを使用します。" Opacity="0.72" />
                <TextBlock Text="時間割の学期" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="TermPreference" SelectionChanged="OnTermPreferenceChanged" HorizontalAlignment="Left" MinWidth="180">
                    <ComboBoxItem Content="自動" Tag="automatic" />
                    <ComboBoxItem Content="前期" Tag="zenki" />
                    <ComboBoxItem Content="後期" Tag="koki" />
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="学内サービス" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="ManabaMobile" Header="manabaをスマホ表示で開く" Toggled="OnServiceDisplayChanged" />
                <ToggleSwitch x:Name="PortalMobile" Header="ポータルをスマホ表示で開く" Toggled="OnServiceDisplayChanged" />
                <TextBlock Text="表示する学内サービス" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ToggleSwitch x:Name="ServiceManaba" Header="manaba" Toggled="OnServiceTabsChanged" />
                <ToggleSwitch x:Name="ServicePortal" Header="ポータル" Toggled="OnServiceTabsChanged" />
                <ToggleSwitch x:Name="ServiceCafeteria" Header="食堂メニュー" Toggled="OnServiceTabsChanged" />
                <ToggleSwitch x:Name="ServiceBus" Header="バスダイヤ" Toggled="OnServiceTabsChanged" />
                <TextBlock Text="Webページを追加" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="CustomServiceTitle" Header="表示名" />
                <TextBox x:Name="CustomServiceUrl" Header="URL" PlaceholderText="https://..." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="追加" Click="OnAddCustomService" />
                    <Button Content="選択したページを削除" Click="OnRemoveCustomService" />
                </StackPanel>
                <ListView x:Name="CustomServiceList" DisplayMemberPath="title" SelectionMode="Single" MaxHeight="144" />
                <TextBlock x:Name="ServiceTabsStatus" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="通知" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="PersonalTodoReminders" Header="自分で追加したToDoの通知" Toggled="OnTodoReminderChanged" />
                <TextBlock Text="Windowsの通知設定でCIT Hubの通知が許可されている必要があります。" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="Windows端末の連携" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="モバイル版で発行した連携コードを入力すると、アカウントに紐付けて同期します。" TextWrapping="Wrap" Opacity="0.72" />
                <TextBox x:Name="PairingCode" PlaceholderText="連携コード" />
                <Button Content="このWindows端末を連携" HorizontalAlignment="Left" Click="OnClaimWindowsDevice" />
                <TextBlock x:Name="PairingStatus" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="サポート" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="連携済みのアカウントで、運営への問い合わせと返信の確認ができます。" TextWrapping="Wrap" Opacity="0.72" />
                <ListView x:Name="SupportMessages" MaxHeight="240" IsItemClickEnabled="True" ItemClick="OnSupportMessageSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8" Spacing="3">
                                <TextBlock Text="{Binding SenderDisplay}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding body}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBox x:Name="SupportDraft" PlaceholderText="メッセージを入力" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="更新" Click="OnRefreshSupport" />
                    <Button Content="送信" Click="OnSendSupport" />
                </StackPanel>
                <TextBlock x:Name="SupportStatus" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="通知センター" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="お知らせを更新" HorizontalAlignment="Left" Click="OnRefreshNotices" />
                <ListView x:Name="NoticeList" IsItemClickEnabled="True" ItemClick="OnNoticeSelected" MaxHeight="280">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8" Spacing="3">
                                <TextBlock Text="{Binding title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding message}" TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="NoticeStatus" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
