<Window
    x:Class="CITHub.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CITHub.Windows.Views"
    Title="CIT Hub">
    <NavigationView x:Name="RootNavigation"
                    PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="時間割" Tag="timetable" Icon="Calendar" />
            <NavigationViewItem Content="ToDo" Tag="todo" Icon="Bullets" />
            <NavigationViewItem Content="学内サービス" Tag="services" Icon="Globe" />
            <NavigationViewItem Content="板書" Tag="board" Icon="Camera" />
            <NavigationViewItem Content="設定" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
